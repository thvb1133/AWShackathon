# Beyond Orbit PHP + database backend
#
# Copy to server/.env to override the zero-setup SQLite defaults.
# Never commit server/.env: it can contain your database password.

# sqlite is the default: one file, no database service to install.
BO_DB_DRIVER=sqlite
BO_DB_PATH=server/data/beyond_orbit.sqlite

# For MySQL/MariaDB instead:
# BO_DB_DRIVER=mysql
# BO_DB_HOST=127.0.0.1
# BO_DB_PORT=3306
# BO_DB_NAME=beyond_orbit
# BO_DB_USER=beyond_orbit
# BO_DB_PASS=replace-me

# Comma-separated browser origins. Use your actual HTTPS domain in production.
# BO_CORS_ORIGINS=https://your-domain.example,https://your-user.github.io

# Optional: a personal NASA key avoids the shared DEMO_KEY limit.
# BO_NASA_KEY=your-key

# PHP asks this service to run the Python/QML classifier.
BO_PYTHON_URL=http://127.0.0.1:8000

# Development only. Never enable on a public server.
BO_DEBUG=0
